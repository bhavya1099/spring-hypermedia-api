package com.baeldung.model;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookGetTitleTest {
    @Tag("valid")
    @Test
    public void testGetTitle(){
        Book book = new Book();
        book.setTitle("To Kill a Mockingbird");
        assertEquals(book.getTitle(), "To Kill a Mockingbird");
    }
    @Tag("invalid")
    @Test
    public void testGetTitleWhenTitleIsNull(){
        Book book = new Book();
        assertNull(book.getTitle());
    }
    @Tag("valid")
    @Test
    public void testGetTitleIsCaseSensitive(){
        Book book = new Book();
        book.setTitle("tO kILL a mOCKINGBIRD");
        assertEquals(book.getTitle(), "tO kILL a mOCKINGBIRD");
    }
    @Tag("valid")
    @Test
    public void testGetTitleUniqueness(){
        Book book1 = new Book();
        book1.setTitle("To Kill a Mockingbird");
        Book book2 = new Book();
        book2.setTitle("The Great Gatsby");
        assertNotEquals(book1.getTitle(), book2.getTitle());
    }
}