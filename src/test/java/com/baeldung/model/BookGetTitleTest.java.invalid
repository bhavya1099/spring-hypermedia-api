package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.DisplayName;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

class BookGetTitleTest {
    @Test
    @Tag("valid")
    @DisplayName("Title Retrieval Test")
    void testGetTitle() {
        // Arrange
        Book book = new Book();
        book.setTitle("The Great Gatsby");
        
        // Act
        String actualTitle = book.getTitle();
        
        // Assert
        assertEquals("The Great Gatsby", actualTitle);
    }
    
    @Test
    @Tag("invalid")
    @DisplayName("Null Title Test")
    void testGetTitleWhenTitleIsNull() {
        // Arrange
        Book book = new Book();
        
        // Act
        String actualTitle = book.getTitle();
        
        // Assert
        assertNull(actualTitle);
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Title Case Sensitivity Test")
    void testGetTitleIsCaseSensitive() {
        // Arrange
        Book book = new Book();
        book.setTitle("The great gatsby");
        
        // Act
        String actualTitle = book.getTitle();
        
        // Assert
        assertEquals("The great gatsby", actualTitle);
        assertNotEquals("The Great Gatsby", actualTitle);
    }
    
    @Test
    @Tag("integration")
    @DisplayName("Uniqueness of Title Test")
    void testGetTitleUniqueness() {
        // Arrange
        Book book1 = new Book();
        Book book2 = new Book();
        book1.setTitle("The Great Gatsby");
        book2.setTitle("Moby Dick");
        
        // Act
        String actualTitle1 = book1.getTitle();
        String actualTitle2 = book2.getTitle();
        
        // Assert
        assertEquals("The Great Gatsby", actualTitle1);
        assertEquals("Moby Dick", actualTitle2);
        assertNotEquals(actualTitle1, actualTitle2);
    }
}