class BookGetIdTest {
    @Test
    @Tag("valid")
    void getIdReturnsSetValue() {
        Book book = new Book();
        Long expectedId = 1L;
        book.setId(expectedId);
        assertEquals(expectedId, book.getId());
    }
    @Test
    @Tag("valid")
    void getIdReturnsNullForNewObject() {
        Book book = new Book();
        assertNull(book.getId());
    }
    @Test
    @Tag("valid")
    void getIdReturnsNullAfterSettingToNull() {
        Book book = new Book();
        book.setId(1L);
        book.setId(null);
        assertNull(book.getId());
    }
    @Test
    @Tag("valid")
    void getIdReturnsLatestSetValue() {
        Book book = new Book();
        book.setId(1L);
        book.setId(2L);
        book.setId(3L);
        assertEquals(3L, book.getId());
    }
