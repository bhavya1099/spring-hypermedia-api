package com.baeldung.model;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import static org.junit.jupiter.api.Assertions.assertNull;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookGetIdTest {
    private Book book;
    @BeforeEach
    public void setUp() {
        book = new Book();
    }
    @Test
    @Tag("valid") // it’s a valid scenario 
    public void testIdIsNullInitially() {
        //Arrange: Done in setUp, no additional arrangements needed
        //Act: Call the getId() method
        Long id = book.getId();
        //Assert: ID should be null initially
        assertNull(id, "Id should be null initially");
    }
    @Test
    @Tag("valid") // it’s a valid scenario 
    public void testSetAndGetId() {
        //Arrange: Set an Id for the book
        Long expectedId = 123L;
        book.setId(expectedId);
        //Act: Call the getId() method
        Long actualId = book.getId();
        //Assert: ID should be same as the value set
        assertEquals(expectedId, actualId, "Id should be the same as the value set");
    }
    @Test
    @Tag("valid") // it’s a valid scenario 
    public void testIdRemainsConstant() {
        //Arrange: Set an Id for the book
        Long expectedId = 456L;
        book.setId(expectedId);
        //Act: Call the getId() method
        Long firstIdCall = book.getId();
        Long secondIdCall = book.getId();
        //Assert: ID should remain the same over multiple getId invocations
        assertEquals(expectedId, firstIdCall, "Id should remain same over multiple getId invocations");
        assertEquals(expectedId, secondIdCall, "Id should remain same over multiple getId invocations");
    }
}