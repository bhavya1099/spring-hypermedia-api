package com.baeldung.model;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookGetIdTest {
    @Test
    @Tag("valid")
    public void testIdIsNullInitially() {
        // Arrange
        Book book = new Book();
        // Act
        Long id = book.getId();
        // Assert
        Assertions.assertNull(id, "Initial book id should be null");
    }
    @Test
    @Tag("valid")
    public void testSetAndGetId() {
        // Arrange
        Book book = new Book();
        Long originalId = 123L;
        book.setId(originalId);
        // Act
        Long id = book.getId();
        // Assert
        Assertions.assertEquals(originalId, id, "Book id should be equal to the set id");
    }
    @Test
    @Tag("valid")
    public void testIdRemainsConstant() {
        // Arrange
        Book book = new Book();
        Long originalId = 456L;
        book.setId(originalId);
        // Act
        Long firstId = book.getId();
        Long secondId = book.getId();
        // Assert
        Assertions.assertEquals(originalId, firstId, "First retrieved id should be equal to the set id");
        Assertions.assertEquals(firstId, secondId, "Id should remain constant across multiple calls");
    }
}