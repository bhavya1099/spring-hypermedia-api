package com.baeldung.model;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class CartIsPurchasedTest {
    private Cart cart;
    private Book book;
    @BeforeEach
    public void setup() {
        cart = new Cart();
        book = new Book();
        book.setAuthor("AuthorName");
        book.setTitle("BookTitle");
        book.setIsbn("ISBN123456");
    }
    @Test
    @Tag("valid")
    public void testEmptyCartNotPurchased() {
        assertFalse(cart.isPurchased(), "Empty cart should not be marked as purchased.");
    }
    @Test
    @Tag("valid")
    public void testNonEmptyCartPurchased() {
        cart.add(book);
        cart.setPurchased(true);
        assertTrue(cart.isPurchased(), "Non-empty cart should be marked as purchased.");
    }
    @Test
    @Tag("valid")
    public void testNonEmptyCartNotPurchased() {
        cart.add(book);
        assertFalse(cart.isPurchased(), "Non-empty cart should not be marked as purchased when purchase is not done.");
    }
    @Test
    @Tag("integration")
    public void testPurchaseByDifferentUsers() {
        Cart anotherCart = new Cart();
        Book anotherBook = new Book();
        anotherBook.setAuthor("AnotherAuthor");
        anotherBook.setTitle("AnotherTitle");
        anotherBook.setIsbn("ISBN789012");
        anotherCart.add(anotherBook);
        anotherCart.setPurchased(true);
        cart.add(book);
        assertTrue(anotherCart.isPurchased(), "Cart of another user should be marked as purchased.");
        assertFalse(cart.isPurchased(), "Cart of current user should not be marked as purchased.");
    }
}