package com.baeldung.model;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotEquals;
import java.util.ArrayList;
import org.junit.jupiter.api.*;
import java.util.List;

public class CartHashCodeTest {
    @BeforeEach
    public void setUp() throws Exception {
    }
    @AfterEach
    public void tearDown() throws Exception {
    }
    @Test
    @Tag("valid")
    public void consistentHashCodesForSameObject() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        Book book1 = new Book();
        Book book2 = new Book();
        cart1.add(book1);
        cart2.add(book2);
        assertEquals(cart1.hashCode(), cart2.hashCode(), "Hash codes are not consistent for the same persistent objects");
    }
    @Test
    @Tag("boundary")
    public void differentHashCodesForDifferentObjects() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        
        Book book1 = new Book("Author1", "Title1", "ISBN1");
        Book book2 = new Book("Author2", "Title2", "ISBN2");
        cart1.add(book1);
        cart2.add(book2);
        assertNotEquals(cart1.hashCode(), cart2.hashCode(), "Hash codes are not unique for different objects");
    }
    @Test
    @Tag("valid")
    public void properHandlingOfNullAndEmptyCarts() {
        Cart nullCart = new Cart();
        nullCart.setBooks(null);
        Cart emptyCart = new Cart();
        emptyCart.setBooks(new ArrayList<Book>());
        assertNotEquals(nullCart.hashCode(), emptyCart.hashCode(), "Hash codes not correctly generated for null and empty Carts");
    }
}