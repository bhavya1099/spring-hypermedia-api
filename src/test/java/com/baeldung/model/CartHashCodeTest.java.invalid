package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.*;

class CartHashCodeTest {
    @Test
    @Tag("valid")
    void emptyCartHashCode() {
        Cart cart = new Cart();
        assertEquals(1237, cart.hashCode());
    }
    @Test
    @Tag("valid")
    void singleBookCartHashCode() {
        Cart cart = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart.add(book);
        assertNotEquals(1237, cart.hashCode());
    }
    @Test
    @Tag("valid")
    void purchasedCartHashCode() {
        Cart cart = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart.add(book);
        cart.setPurchased(true);
        assertNotEquals(cart.hashCode(), new Cart().hashCode());
    }
    @Test
    @Tag("valid")
    void equalCartsHashCode() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart1.add(book);
        cart2.add(book);
        assertEquals(cart1.hashCode(), cart2.hashCode());
    }
    @Test
    @Tag("valid")
    void multipleBookCartHashCode() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        Book book1 = new Book("Author1", "Title1", "ISBN1");
        Book book2 = new Book("Author2", "Title2", "ISBN2");
        cart1.add(book1);
        cart2.add(book1);
        cart2.add(book2);
        assertNotEquals(cart1.hashCode(), cart2.hashCode());
    }
    @Test
    @Tag("valid")
    void consistentHashCode() {
        Cart cart = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart.add(book);
        int hashCode1 = cart.hashCode();
        int hashCode2 = cart.hashCode();
        int hashCode3 = cart.hashCode();
        assertEquals(hashCode1, hashCode2);
        assertEquals(hashCode2, hashCode3);
    }
}