package com.baeldung.model;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotEquals;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookHashCodeTest {
    @Tag("valid")
    @Test
    public void testDefaultBookHashCode() {
        // Arrange
        Book book = new Book();
        // Act
        int actual = book.hashCode();
        // Assert
        assertEquals(1, actual);
    }
    @Tag("valid")
    @Test
    public void testBookHashCodeWithSpecificAttributes() {
        // Arrange
        String author = "Author";
        String title = "Title";
        String isbn = "ISBN";
        int expectedHashCode = ((31 + author.hashCode())*31 + isbn.hashCode())*31 + title.hashCode();
        Book book = new Book(author, title, isbn);
        // Act
        int actualHashCode = book.hashCode();
        // Assert
        assertEquals(expectedHashCode, actualHashCode);
    }
    @Tag("valid")
    @Test
    public void testHashCodeConsistency() {
        // Arrange
        Book book = new Book("Author", "Title", "ISBN");
        
        // Act & Assert
        assertEquals(book.hashCode(), book.hashCode());
    }
    @Tag("valid")
    @Test
    public void testDistinctHashCodeForDifferentBooks() {
        // Arrange
        Book book1 = new Book("Author1", "Title1", "ISBN1");
        Book book2 = new Book("Author2", "Title2", "ISBN2");
        // Act
        int hashCode1 = book1.hashCode();
        int hashCode2 = book2.hashCode();
        // Assert
        assertNotEquals(hashCode1, hashCode2);
    }
}