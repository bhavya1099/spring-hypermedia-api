package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

class BookHashCodeTest {
    @Test
    @Tag("valid")
    void hashCodeWithAllFieldsSet() {
        Book book = new Book("John Doe", "Test Book", "1234567890");
        int hashCode = book.hashCode();
        assertNotEquals(0, hashCode);
        assertEquals(hashCode, book.hashCode());
    }
    @Test
    @Tag("boundary")
    void hashCodeWithNullFields() {
        Book book = new Book();
        assertEquals(1, book.hashCode());
    }
    @Test
    @Tag("valid")
    void hashCodeConsistencyForEqualBooks() {
        Book book1 = new Book("John Doe", "Test Book", "1234567890");
        Book book2 = new Book("John Doe", "Test Book", "1234567890");
        assertEquals(book1.hashCode(), book2.hashCode());
    }
    @Test
    @Tag("valid")
    void hashCodeDifferenceForDifferentAuthors() {
        Book book1 = new Book("John Doe", "Test Book", "1234567890");
        Book book2 = new Book("Jane Doe", "Test Book", "1234567890");
        assertNotEquals(book1.hashCode(), book2.hashCode());
    }
    @Test
    @Tag("valid")
    void hashCodeDifferenceForDifferentIsbns() {
        Book book1 = new Book("John Doe", "Test Book", "1234567890");
        Book book2 = new Book("John Doe", "Test Book", "0987654321");
        assertNotEquals(book1.hashCode(), book2.hashCode());
    }
    @Test
    @Tag("valid")
    void hashCodeDifferenceForDifferentTitles() {
        Book book1 = new Book("John Doe", "Test Book", "1234567890");
        Book book2 = new Book("John Doe", "Another Test Book", "1234567890");
        assertNotEquals(book1.hashCode(), book2.hashCode());
    }
}