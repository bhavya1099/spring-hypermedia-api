public class BookGetIsbnTest {
    @Test
    @Tag("valid")
    public void ensureThatGetIsbnReturnsProperValue() {
        // Arrange
        Book book1 = new Book();
        book1.setIsbn("978-3-16-148410-0");
        
        // Act
        String actualIsbnBook1 = book1.getIsbn();
        
        // Assert 
        assertEquals("978-3-16-148410-0", actualIsbnBook1);
    }
    @Test
    @Tag("valid")
    public void ensureGetIsbnReturnsNullWhenNothingIsSet() {
        // Arrange
        Book book1 = new Book();
        
        // Act
        String actualIsbnBook1 = book1.getIsbn();
        
        // Assert 
        assertNull(actualIsbnBook1);
    }
    @Test
    @Tag("valid")
    public void ensureGetIsbnRecoverFromErrorGracefully() {
        // Testing for robustness: Since the book's constructor and getIsbn do not throw any checked exceptions, 
	// there is no arrange or act step in this test case. We're asserting that it doesn’t fail under normal circumstances.
	assertDoesNotThrow(() -> {
	  Book book1 = new Book();
	  book1.getIsbn();
	});
    }
