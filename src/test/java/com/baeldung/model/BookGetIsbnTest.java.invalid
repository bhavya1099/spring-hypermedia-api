public class BookGetIsbnTest {
    @Test
    @Tag("valid")
    public void ensureThatGetIsbnReturnsProperValue() {
        // Arrange
        String expectedIsbn = "123456789";
        Book book = new Book();
        book.setIsbn(expectedIsbn);
        
        // Act
        String actualIsbn = book.getIsbn();
        
        // Assert
        assertEquals(expectedIsbn, actualIsbn, "Expected ISBN does not match the actual ISBN");
    }
    @Test
    @Tag("boundary")
    public void ensureGetIsbnReturnsNullWhenNothingIsSet() {
        // Arrange
        Book book = new Book();
        
        // Act
        String isbn = book.getIsbn();
        
        // Assert
        assertNull(isbn, "Expected null but was " + isbn);
    }
