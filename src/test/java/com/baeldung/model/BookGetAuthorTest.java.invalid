package com.baeldung.model;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNull;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookGetAuthorTest {
    @Test
    @Tag("valid")
    public void testGetAuthorWithValidDataSet() {
        // Arrange
        Book book = new Book();
        book.setAuthor("Stephen King");
        
        // Act
        String actualAuthor = book.getAuthor();
        
        // Assert
        assertEquals("Stephen King", actualAuthor, "Author should be Stephen King");
    }
    @Test
    @Tag("valid")
    public void testGetAuthorWithoutDataSet() {
        // Arrange
        Book book = new Book();
        
        // Act
        String actualAuthor = book.getAuthor();
        
        // Assert
        assertNull(actualAuthor, "Author should be null as it's not set");
    }
    @Test
    @Tag("boundary")
    public void testGetAuthorWithEmptyString() {
        // Arrange
        Book book = new Book();
        book.setAuthor("");
        
        // Act
        String actualAuthor = book.getAuthor();
        
        // Assert
        assertEquals("", actualAuthor, "Author should be empty string as it's set to empty string");
    }
}