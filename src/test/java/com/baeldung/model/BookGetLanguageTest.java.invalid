import com.fasterxml.jackson.annotation.JsonView;

public class BookGetLanguageTest {
    
    @Test
    @Tag("valid")
    public void testGetLanguageMethod() {
        //Arrange
        Book book = new Book();
        book.setLanguage("English");
        //Act
        String result = book.getLanguage();
        //Assert
        Assertions.assertEquals("English", result);
    }
    @Test
    @Tag("boundary")
    public void testGetLanguageReturnsNullWhenNoLanguageIsSet() {
        //Arrange
        Book book = new Book();
        //Act
        String result = book.getLanguage();
        //Assert
        Assertions.assertNull(result);
    }
    @Test
    @Tag("valid")
    public void testGetLanguageReturnsNewLanguageAfterSettingANewOne() {
        //Arrange
        Book book = new Book();
        book.setLanguage("English");
        book.setLanguage("French");
        //Act
        String result = book.getLanguage();
        //Assert
        Assertions.assertEquals("French", result);
    }
}