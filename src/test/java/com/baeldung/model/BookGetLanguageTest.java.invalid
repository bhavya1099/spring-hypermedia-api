package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.CsvSource;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

class BookGetLanguageTest {
    private Book book;
    @BeforeEach
    void setUp() {
        book = new Book();
    }
    @Test
    @Tag("valid")
    void getLanguageWhenLanguageIsSet() {
        book.setLanguage("English");
        assertEquals("English", book.getLanguage());
    }
    @Test
    @Tag("valid")
    void getLanguageWhenLanguageIsNull() {
        assertNull(book.getLanguage());
    }
    @Test
    @Tag("valid")
    void getLanguageAfterChangingLanguage() {
        book.setLanguage("English");
        book.setLanguage("French");
        assertEquals("French", book.getLanguage());
    }
    @ParameterizedTest
    @CsvSource({"English,English", "French,French", "German,German"})
    @Tag("valid")
    void getLanguageForMultipleBooks(String language, String expected) {
        book.setLanguage(language);
        assertEquals(expected, book.getLanguage());
    }
    @Test
    @Tag("boundary")
    void getLanguageWithEmptyString() {
        book.setLanguage("");
        assertEquals("", book.getLanguage());
    }
}