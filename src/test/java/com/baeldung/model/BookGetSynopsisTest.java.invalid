package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

class BookGetSynopsisTest {
    @Test
    @Tag("valid")
    void getSynopsisWhenSet() {
        Book book = new Book();
        String expectedSynopsis = "A thrilling adventure story";
        book.setSynopsis(expectedSynopsis);
        assertEquals(expectedSynopsis, book.getSynopsis());
    }
    @Test
    @Tag("valid")
    void getSynopsisWhenNotSet() {
        Book book = new Book();
        assertNull(book.getSynopsis());
    }
    @Test
    @Tag("boundary")
    void getEmptySynopsis() {
        Book book = new Book();
        book.setSynopsis("");
        assertEquals("", book.getSynopsis());
    }
    @Test
    @Tag("boundary")
    void getLongSynopsis() {
        Book book = new Book();
        String longSynopsis = "a".repeat(1000);
        book.setSynopsis(longSynopsis);
        assertEquals(longSynopsis, book.getSynopsis());
    }
    @Test
    @Tag("valid")
    void getSynopsisAfterMultipleSets() {
        Book book = new Book();
        book.setSynopsis("Initial synopsis");
        book.setSynopsis("Updated synopsis");
        assertEquals("Updated synopsis", book.getSynopsis());
    }
}