package com.baeldung.model;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import java.util.ArrayList;
import java.util.List;
import org.junit.jupiter.api.*;

class CartEqualsTest {
    @Test
    @Tag("valid")
    void equalCartsWithSameBooksAndPurchaseStatus() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart1.add(book);
        cart2.add(book);
        cart1.setPurchased(true);
        cart2.setPurchased(true);
        assertTrue(cart1.equals(cart2));
    }
    @Test
    @Tag("invalid")
    void unequalCartsWithDifferentBooks() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        cart1.add(new Book("Author1", "Title1", "ISBN1"));
        cart2.add(new Book("Author2", "Title2", "ISBN2"));
        assertFalse(cart1.equals(cart2));
    }
    @Test
    @Tag("invalid")
    void unequalCartsWithDifferentPurchaseStatus() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        Book book = new Book("Author", "Title", "ISBN");
        cart1.add(book);
        cart2.add(book);
        cart1.setPurchased(true);
        cart2.setPurchased(false);
        assertFalse(cart1.equals(cart2));
    }
    @Test
    @Tag("boundary")
    void compareCartWithNull() {
        Cart cart = new Cart();
        assertFalse(cart.equals(null));
    }
    @Test
    @Tag("boundary")
    void compareCartWithDifferentObjectType() {
        Cart cart = new Cart();
        assertFalse(cart.equals("Not a Cart"));
    }
    @Test
    @Tag("boundary")
    void equalCartsWithEmptyBookLists() {
        Cart cart1 = new Cart();
        Cart cart2 = new Cart();
        assertTrue(cart1.equals(cart2));
    }
    @Test
    @Tag("valid")
    void compareCartWithItself() {
        Cart cart = new Cart();
        cart.add(new Book("Author", "Title", "ISBN"));
        assertTrue(cart.equals(cart));
    }
}